 "soc_reachable": 1.0, "status": "applied"}], "met": 1, "sessions": 1, "shortfall_kwh": 0.0, "unavoidable_kwh": 0.0, "avoidable_kwh": 0.0, "peak_tx_loading": 71.33890434531116, "steps_verified_pct": 100.0, "ev_satisfaction": 1.0}, "need_now_no_notice": {"description": "Unannounced disconnection (notice = departure). Controller can only expose the SOC it already banked.", "ledger": [{"step": 26, "ev": 29, "event": "declared", "kind": "need_now", "ready_by_step": 26, "feasible": false, "kwh_needed": 8.03, "kwh_deliverable": 0.0, "unavoidable_shortfall_kwh": 8.033, "soc_reachable": 0.327, "status": "applied_infeasible"}], "met": 0, "sessions": 1, "shortfall_kwh": 7.492565279166651, "unavoidable_kwh": 8.033, "avoidable_kwh": 0.0, "peak_tx_loading": 69.96990971524123, "steps_verified_pct": 100.0, "ev_satisfaction": 1.0}, "need_now_insufficient_time": {"description": "One step of notice: physics forbids the target; the ledger must say so, not promise it.", "ledger": [{"step": 26, "ev": 29, "event": "declared", "kind": "need_now", "ready_by_step": 27, "feasible": false, "kwh_needed": 8.03, "kwh_deliverable": 2.53, "unavoidable_shortfall_kwh": 5.503, "soc_reachable": 0.467, "status": "applied_infeasible"}], "met": 0, "sessions": 1, "shortfall_kwh": 4.96256527916665, "unavoidable_kwh": 5.503, "avoidable_kwh": 0.0, "peak_tx_loading": 70.09063048166526, "steps_verified_pct": 100.0, "ev_satisfaction": 1.0}, "competing_requirements": {"description": "12 users declare need-now at once on top of the evening peak: electrical protection keeps precedence.", "ledger": [{"step": 21, "ev": 41, "event": "declared", "kind": "need_now", "ready_by_step": 24, "feasible": true, "kwh_needed": 0.0, "kwh_deliverable": 4.08, "unavoidable_shortfall_kwh": 0.0, "soc_reachable": 1.0, "status": "applied"}, {"step": 22, "ev": 30, "event": "declared", "kind": "need_now", "ready_by_step": 25, "feasible": true, "kwh_needed": 2.47, "kwh_deliverable": 4.97, "unavoidable_shortfall_kwh": 0.0, "soc_reachable": 0.931, "status": "applied"}, {"step": 23, "ev": 7, "event": "declared", "kind": "need_now", "ready_by_step": 26, "feasible": true, "kwh_needed": 0.0, "kwh_deliverable": 2.28, "unavoidable_shortfall_kwh": 0.0, "soc_reachable": 0.925, "status": "applied"}, {"step": 23, "ev": 34, "event": "declared", "kind": "need_now", "ready_by_step": 26, "feasible": true, "kwh_needed": 0.0, "kwh_deliverable": 3.56, "unavoidable_shortfall_kwh": 0.0, "soc_reachable": 1.0, "status": "applied"}, {"step": 23, "ev": 39, "event": "declared", "kind": "need_now", "ready_by_step": 26, "feasible": true, "kwh_needed": 0.0, "kwh_deliverable": 4.97, "unavoidable_shortfall_kwh": 0.0, "soc_reachable": 0.884, "status": "applied"}, {"step": 23, "ev": 49, "event": "declared", "kind": "need_now", "ready_by_step": 26, "feasible": true, "kwh_needed": 1.63, "kwh_deliverable": 7.45, "unavoidable_shortfall_kwh": 0.0, "soc_reachable": 1.0, "status": "applied"}, {"step": 24, "ev": 21, "event": "declared", "kind": "need_now", "ready_by_step": 27, "feasible": true, "kwh_needed": 1.61, "kwh_deliverable": 4.97, "unavoidable_shortfall_kwh": 0.0, "soc_reachable": 0.937, "status": "applied"}, {"step": 25, "ev": 47, "event": "declared", "kind": "need_now", "ready_by_step": 28, "feasible": true, "kwh_needed": 0.0, "kwh_deliverable": 2.28, "unavoidable_shortfall_kwh": 0.0, "soc_reachable": 0.898, "status": "applied"}, {"step": 26, "ev": 12, "event": "declared", "kind": "need_now", "ready_by_step": 29, "feasible": true, "kwh_needed": 0.25, "kwh_deliverable": 4.97, "unavoidable_shortfall_kwh": 0.0, "soc_reachable": 0.906, "status": "applied"}, {"step": 26, "ev": 28, "event": "declared", "kind": "need_now", "ready_by_step": 29, "feasible": true, "kwh_needed": 2.13, "kwh_deliverable": 4.97, "unavoidable_shortfall_kwh": 0.0, "soc_reachable": 0.908, "status": "applied"}, {"step": 27, "ev": 1, "event": "declared", "kind": "need_now", "ready_by_step": 30, "feasible": false, "kwh_needed": 4.0, "kwh_deliverable": 2.28, "unavoidable_shortfall_kwh": 1.724, "soc_reachable": 0.795, "status": "applied_infeasible"}, {"step": 27, "ev": 6, "event": "declared", "kind": "need_now", "ready_by_step": 30, "feasible": true, "kwh_needed": 2.5, "kwh_deliverable": 4.97, "unavoidable_shortfall_kwh": 0.0, "soc_reachable": 0.97, "status": "applied"}], "met": 11, "sessions": 12, "shortfall_kwh": 0.8243006716901913, "unavoidable_kwh": 1.724, "avoidable_kwh": 0.0, "peak_tx_loading": 71.33890434531116, "steps_verified_pct": 100.0, "ev_satisfaction": 1.0}}, "limitations": ["All demand, PV, EV and weather inputs are SYNTHETIC. Absolute kW/INR figures are not predictions for a real feeder.", "Weather forecasts are synthetic issue-time forecasts with an assumed skill-vs-lead curve (nwp.py); no real NWP was used.", "Forecast skill on demand is optimistic: synthetic demand has far less idiosyncratic noise than metered homes.", "The PV ensemble under-covers persistent-haze days: the forecaster does not anticipate multi-hour regime persistence beyond its skill horizon.", "A P10 departure commitment accepts tail risk: the optimiser misses 1-2 % of EV requirements (uncoordinated: 0 %). The cost of coordination is measured here, not hidden.", "The optimiser uses LESS of the available solar than the uncoordinated baseline (about 92 % vs 95 % utilisation): the chance constraints are conservative and the PV ensemble is over-dispersed on clear days (about 99 % coverage for a nominal 80 % band). Known weakness; not tuned away.", "The 'rule_tou' arm looks safe at the transformer only because the safety layer clips it; compare its safety-intervention count, not just its peak.", "Safety verification is a simulated AC power flow on a nominal model. Stale telemetry, actuator faults, model error beyond the calibrated margin and real protection relays are out of scope.", "The twin-calibration study identifies one parameter (LV impedance) on a plant of the same structure; structural mismatch is not tested here.", "MARL is NOT implemented. The policy interface and two benchmark arms exist; any RL result must be reported as a delta against them.", "No hardware-in-the-loop. Simulation endpoints cannot control equipment.", "The reference grid solver is a backward/forward sweep, cross-checked against OpenDSS only where validate_backends.py has been run."], "provenance": {"python": "3.12.3", "platform": "Linux-6.18.44-fc-v51-x86_64-with-glibc2.39", "numpy": "2.4.4", "scipy": "1.17.1", "sklearn": "1.8.0", "opendssdirect": null, "source_sha256_16": {"__init__.py": "1c5fe283f1d83c50", "calibration.py": "0232863fceb85296", "config.py": "99e9c382e7ab6aef", "control.py": "a348fed3ac98d1eb", "controllers.py": "0d395ceb7ef388c6", "dataset.py": "51b5d5f03409057b", "forecast.py": "d9de6c548c36c9c8", "grid.py": "cde65e7415ad00ca", "nwp.py": "0ec82ee1b002ed10", "runner.py": "a5a11e765ac05129", "seeds.py": "fe88a1f995e4834c", "service.py": "6fe3f55517260991", "world.py": "ac19a5312a6d788e"}, "config": {"n_homes": 300, "n_ev": 60, "n_pv": 150, "n_bess": 26, "n_comm": 10, "tx_kva": 630.0, "seed": 7, "n_feeders": 4, "seg_per_feeder": 10, "backend": "auto"}, "reps": 5, "dev_seed": 7, "held_out_seeds": [21, 22]}}